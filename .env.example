# SmartScreen - 개발용 설정 템플릿
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다(.gitignore).
#   copy .env.example .env
#
# 값을 채우고 알려주면 PC 쪽(client/) 과 폰 쪽(ios/) 에 반영한다.

# ---------------------------------------------------------------------------
# Supabase 프로젝트
# ---------------------------------------------------------------------------
# 대시보드 > Project Settings > API (또는 Data API) 에서 가져온다.
#   URL      예: https://abcdefghijklmnop.supabase.co
#   anon key 예: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# iOS 로그인 리다이렉트
# ---------------------------------------------------------------------------
# 폰 앱이 구글 로그인을 마치고 돌아올 커스텀 URL 스킴.
# 같은 값을 Supabase > Authentication > URL Configuration > Redirect URLs 에도
# 넣어야 하고, Xcode 의 Info.plist 에도 URL Type 으로 등록해야 한다.
IOS_REDIRECT_SCHEME=ssbeacon://login-callback

# ---------------------------------------------------------------------------
# 기업 콘텐츠 (선택)
# ---------------------------------------------------------------------------
# 기존 기능을 새 프로젝트에서 살릴 경우에만. supabase/schema.sql 을 먼저 적용한다.
# 안 쓸 거면 비워 둔다.
ORG_ID=


# ===========================================================================
# 여기에 넣지 말 것
# ===========================================================================
#
# Google OAuth Client Secret
#   Supabase 대시보드에만 넣는다 (Authentication > Providers > Google).
#   클라이언트가 가질 이유가 없다. PC 의 exe 나 폰 앱 번들에 들어가면
#   누구나 꺼낼 수 있고, 꺼내면 우리 이름으로 로그인 흐름을 만들 수 있다.
#
# service_role key
#   RLS 를 통째로 무시하는 키다. 이게 클라이언트에 들어가면 device_tokens 의
#   남의 토큰까지 전부 읽히고, 토큰을 아는 사람은 그 사람 화면을 열어둘 수 있다.
#   서버에서만 쓰는 값이고 이 저장소에는 올 일이 없다.
#
# anon key 는 다르다. 위에 둬도 된다.
#   공개되도록 설계된 값이고 지금도 exe 에 문자열로 박혀 있다
#   (client/main.cpp 의 등록 대화상자). 보호하는 것은 키가 아니라 RLS 다.
#   그래서 device_tokens 의 RLS 에 anon 정책을 하나도 두지 않았다 -
#   anon key 만으로는 한 줄도 못 읽는다. supabase/device_tokens.sql 참고.
